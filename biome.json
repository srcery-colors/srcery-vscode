{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "biome.json",
      "package.json",
      "release.config.mjs",
      "scripts/**/*.mjs",
      "themes/**/*.json"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "overrides": [
    {
      "includes": ["themes/**/*.json"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
