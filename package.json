{
  "name": "srcery-colors",
  "displayName": "Srcery (official port)",
  "description": "Srcery theme based on the srcery-colors themes",
  "version": "0.4.4",
  "publisher": "srcery-colors",
  "license": "MIT",
  "engines": {
    "vscode": "^1.19.0"
  },
  "categories": [
    "Themes"
  ],
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#1c1b19",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "Srcery",
        "uiTheme": "vs-dark",
        "path": "./themes/Srcery-color-theme.json"
      }
    ]
  },
  "bugs": {
    "url": "https://github.com/srcery-colors/srcery-vscode/issues"
  },
  "homepage": "https://github.com/srcery-colors/srcery-vscode/master/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/srcery-colors/srcery-vscode"
  },
  "keywords": [
    "srcery",
    "vscode-theme",
    "color-theme",
    "dark-theme",
    "theme",
    "vscode",
    "colorscheme",
    "syntax-highlighting",
    "editor-theme"
  ],
  "files": [
    "assets/icon.png",
    "CHANGELOG.md",
    "LICENSE",
    "themes/Srcery-color-theme.json",
    "themes/srcery.tmTheme"
  ],
  "scripts": {
    "biome:check": "biome check --write .",
    "biome:ci": "biome ci .",
    "check:theme": "node scripts/sync_tmtheme.mjs --check",
    "package": "vsce package --no-dependencies",
    "sync:theme": "node scripts/sync_tmtheme.mjs",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@vscode/vsce": "4.1.1",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "ovsx": "1.4.0",
    "semantic-release": "26.0.1",
    "xml2js": "0.6.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.13.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.0.0 <13.0.0"
    }
  }
}
